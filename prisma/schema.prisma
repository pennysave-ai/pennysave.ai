generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A model to store the 3rd party account details for authentication
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// A model to handle JWT sessions for mobile clients
model MobileJWTToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Token Family Management
  familyId      String
  tokenVersion  Int      @default(1) // Version number for rotation

  // Hashed tokens for security
  accessTokenHash   String    @unique
  refreshTokenHash  String    @unique
  
  // Token metadata
  isActive      Boolean   @default(true)
  expiresAt     DateTime
  refreshExpiresAt DateTime
  
  // Family invalidation tracking
  familyInvalidated Boolean  @default(false)
  invalidatedAt     DateTime?
  invalidatedReason String?   // "compromised", "logout", "suspicious_activity"

  // Usage tracking for anomaly detection
  lastUsedAt    DateTime?
  usageCount    Int       @default(0)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Pending confirmation field to track if the token was recieved by the mobile client
  pendingConfirmation Boolean @default(false)
  
  @@index([userId, isActive])
  @@index([familyId, tokenVersion])
  @@index([userId, familyInvalidated])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  category      Category[]
  budgets       Budget[]
  password      String?
  role          UserRole @default(USER)
  stripeCustomerId String?
  stripeSubscriptionEndDate DateTime?
  stripeSubscriptionCancelAtDate DateTime?
  stripePriceId String?
  hasActiveStripeSubscription Boolean? @default(false)
  appleSubscriptionExpiresAt DateTime?
  appleSubscriptionCountry String?
  appleSubscriptionGracePeriodExpiresAt DateTime?
  appleSubscriptionStatus String?   @default("inactive") // "active", "past_due", "grace_period", "canceled", "grace_period_expired","active_until_expiration", "trial"
  report Report[]
  sendMonthlyReport Boolean? @default(false)
  gdprConsent DateTime?
  mobileTokens  MobileJWTToken[]
  accountAccess UserAccountAccess[]
  createdTransactions Transaction[]
}

model Transaction {
  id          String    @id @default(uuid())
  amount      Int
  payee       String?
  notes       String?
  accountId   String
  account     UserAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   String    // User ID of who created this transaction
  createdByUser User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@unique([id])
  @@index([createdBy])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String?
  icon        String?
  transactions Transaction[]
  budgetAllocations BudgetAllocation[]
  @@unique([id])
}

model Currency {
  id          String    @id @default(uuid())
  name        String
  code        String
  symbol      String
  userAccounts UserAccount[]
  exchangeRate Float
  budget Budget[]
  @@unique([id])
}

// A Model to store the verification token for user credentials signup
model VerificationToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires    DateTime
  @@unique([email, token])
}

// A model to store the reset password token
model PasswordResetToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires    DateTime
  @@unique([email, token])
}

// A model to store User Accounts
model UserAccount {
  id         String   @id @default(uuid())
  // userId     String
  // user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  institutionName String?
  stripeAccountId String?
  stripeLastTransactionsRefreshId String?
  last4      String?
  balance   Int?
  stripeAccountType      String?  
  transactions Transaction[]
  currencyId String
  currency   Currency  @relation(fields: [currencyId], references: [id])
  budgets    BudgetAccount[]
  userAccess UserAccountAccess[] // Many-to-many relation
  @@unique([id])
}

// Join table for User and UserAccount (shareable accounts)
model UserAccountAccess {
  userId        String
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAccountId String
  userAccount   UserAccount   @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  role          String?       // "owner", "viewer", "editor"
  createdAt     DateTime      @default(now())
  
  @@id([userId, userAccountId])
}

// Join table for Budget and UserAccount
model BudgetAccount {
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userAccountId String
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  @@id([budgetId, userAccountId])
}

// Enum to represent budget frequency
enum BudgetFrequency {
  WEEKLY
  MONTHLY
  YEARLY
  QUARTERLY
}

model Budget {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String
  enableNotifications Boolean @default(false)
  description   String
  totalAmount   Float
  currencyId    String
  currency      Currency  @relation(fields: [currencyId], references: [id])
  frequency     BudgetFrequency
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  budgetAllocations BudgetAllocation[]
  accounts      BudgetAccount[]
}

// New model for Budget Allocations
model BudgetAllocation {
  id            String    @id @default(uuid())
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allocatedAmount Float
}
// Model for financial reports
model Report {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  data          Json      // JSON data for the report, it might be changed frequently and we don't want to change the schema, indexing and querying is not that important
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  
  @@index([userId, createdAt])
}