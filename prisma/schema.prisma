generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

// A model to store the 3rd party account details for authentication
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// A model to handle JWT sessions for mobile clients
model MobileJWTToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Token Family Management
  familyId      String
  tokenVersion  Int      @default(1) // Version number for rotation

  // Hashed tokens for security
  accessTokenHash   String    @unique
  refreshTokenHash  String    @unique
  
  // Token metadata
  isActive      Boolean   @default(true)
  expiresAt     DateTime
  refreshExpiresAt DateTime
  
  // Family invalidation tracking
  familyInvalidated Boolean  @default(false)
  invalidatedAt     DateTime?
  invalidatedReason String?   // "compromised", "logout", "suspicious_activity"

  // Usage tracking for anomaly detection
  lastUsedAt    DateTime?
  usageCount    Int       @default(0)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Pending confirmation field to track if the token was recieved by the mobile client
  pendingConfirmation Boolean @default(false)
  
  @@index([userId, isActive])
  @@index([familyId, tokenVersion])
  @@index([userId, familyInvalidated])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(uuid())
  name          String?
  /// IANA timezone id, e.g. "Europe/Madrid", "America/New_York" used to send notifiactions at the right time, default is UTC
  timezone      String?   @default("UTC")
  email         String?   @unique
  preferredLanguage String? @default("EN")
  preferredCurrency Currency? @relation(fields: [preferredCurrencyId], references: [id])
  preferredCurrencyId String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  category      Category[]
  budgets       Budget[]
  feedbacks    Feedback[]
  password      String?
  role          UserRole @default(USER)
  stripeCustomerId String?
  stripeSubscriptionEndDate DateTime?
  stripeSubscriptionCancelAtDate DateTime?
  stripePriceId String?
  hasActiveStripeSubscription Boolean? @default(false)
  appleSubscriptionExpiresAt DateTime?
  appleSubscriptionCountry String?
  appleSubscriptionGracePeriodExpiresAt DateTime?
  appleSubscriptionStatus String   @default("inactive") // "active", "past_due", "grace_period", "canceled", "grace_period_expired","active_until_expiration", "trial"
  report Report[]
  sendMonthlyReport Boolean? @default(false)
  gdprConsent DateTime?
  mobileTokens  MobileJWTToken[]
  accountAccess UserAccountAccess[]
  createdTransactions Transaction[]
  deviceToken String? @unique
  createdInvites AccountInvite[]
  createdReceipts    Receipt[] @relation("ReceiptCreatedBy")
}

model Transaction {
  id          String    @id @default(uuid())
  amount      Int
  payee       String?
  notes       String?
  accountId   String
  account     UserAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receipt     Receipt?
  createdBy   String    // User ID of who created this transaction
  createdByUser User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  @@unique([id])
  @@index([createdBy])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  userId      String
  owner       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String?
  icon        String?
  transactions Transaction[]
  budgetAllocations BudgetAllocation[]
  @@unique([id])
}

model Currency {
  id          String    @id @default(uuid())
  name        String
  code        String
  symbol      String
  userAccounts UserAccount[]
  exchangeRate Float
  budget Budget[]
  receipts Receipt[]
  users        User[]
  @@unique([id])
}

// A Model to store the verification token for user credentials signup
model VerificationToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires    DateTime
  @@unique([email, token])
}

// A model to store the reset password token
model PasswordResetToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires    DateTime
  @@unique([email, token])
}

// A model to store User Accounts
model UserAccount {
  id         String   @id @default(uuid())
  name       String
  institutionName String?
  stripeAccountId String?
  stripeLastTransactionsRefreshId String?
  last4      String?
  balance   Int?
  stripeAccountType      String?  
  transactions Transaction[]
  currencyId String
  currency   Currency  @relation(fields: [currencyId], references: [id])
  budgets    BudgetAccount[]
  userAccess UserAccountAccess[] // Many-to-many relation
  invites    AccountInvite[]
  receipts Receipt[]
  @@unique([id])
}

// Join table for User and UserAccount (shareable accounts)
model UserAccountAccess {
  userId        String
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAccountId String
  userAccount   UserAccount   @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  role          String?       // "owner", "collaborator", "editor"
  createdAt     DateTime      @default(now())
  
  @@id([userId, userAccountId])
}

// Table to store shared account invites
model AccountInvite {
  id          String      @id @default(uuid())
  token       String      @unique
  accountId   String
  account     UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime    @default(now())
  
  @@index([token])
  @@index([accountId])
}

// Join table for Budget and UserAccount
model BudgetAccount {
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userAccountId String
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  @@id([budgetId, userAccountId])
}

// Enum to represent budget frequency
enum BudgetFrequency {
  WEEKLY
  MONTHLY
  YEARLY
  QUARTERLY
}

model Budget {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String
  enableNotifications Boolean @default(false)
  description   String
  totalAmount   Float
  currencyId    String
  currency      Currency  @relation(fields: [currencyId], references: [id])
  frequency     BudgetFrequency
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  budgetAllocations BudgetAllocation[]
  accounts      BudgetAccount[]
}

// New model for Budget Allocations
model BudgetAllocation {
  id            String    @id @default(uuid())
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allocatedAmount Float
}
// Model for financial reports
model Report {
  id            String    @id @default(uuid())
  userId        String
  periodStart   DateTime  // month bucket, e.g. 2026-01-01T00:00:00.000Z
  health        String?  // "green" | "yellow" | "red" - overall financial health for the period
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  data          Json      // JSON data for the report, it might be changed frequently and we don't want to change the schema, indexing and querying is not that important
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  snapshot      ReportSnapshot?
  recurringCandidates ReportRecurringCandidate[]
  categoryBreakdowns  ReportCategoryBreakdown[]
  comparisons   ReportComparison?
  
  @@index([userId, createdAt])
}

// Model to store user feedback
model Feedback {
  id        String   @id @default(uuid())
  userId    String
  message   String   @db.Text
  
  // Device info as separate columns
  deviceModel      String?  @db.VarChar(50)
  deviceOsVersion  String?  @db.VarChar(10)
  deviceAppVersion String?  @db.VarChar(10)
  
  // Metadata
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
}

model Store {
  id         String   @id @default(uuid())
  name       String

  // PostGIS point for radius searches (global store catalog).
  // Prisma can't type this natively, so we use Unsupported + add indexes via SQL migration.
  geom       Unsupported("geography(Point,4326)")?

  street     String?
  city       String?
  postalCode String?
  country    String?

  receipts   Receipt[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
}

model Receipt {
  id            String   @id @default(uuid())

  // Account scoping (important in your app since accounts are shareable)
  accountId     String
  account       UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Who uploaded/created the receipt
  createdBy     String
  createdByUser User @relation("ReceiptCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  storeId       String?
  store         Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  rawOCRAddress String?  @db.Text // Raw OCR address text for manual geocoding fallback

  // Link to the Transaction created from this receipt
  transactionId String? @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  purchasedAt   DateTime?
  
  currencyId    String
  currency  Currency @relation(fields: [currencyId], references: [id])

  items         ReceiptItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId, createdAt])
  @@index([storeId, purchasedAt])
  @@index([createdBy])
}

model ReceiptItem {
  id              String   @id @default(uuid())

  receiptId       String
  receipt         Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  rawName         String
  canonicalItemId String?
  canonicalItem   CanonicalItem? @relation(fields: [canonicalItemId], references: [id], onDelete: SetNull)

  quantity        Float?
  unit            String?
  unitPrice       Int?     // milliunits
  price           Int      // milliunits

  // Normalized for fair comparisons (€/kg, €/L, €/unit)
  normalizedQuantity  Float?
  normalizedUnit      String? // "kg" | "l" | "unit"
  normalizedUnitPrice Int?    // milliunits per normalizedUnit

  @@index([receiptId])
  @@index([canonicalItemId])
}

model CanonicalItem {
  id            String   @id @default(uuid())
  canonicalName String

  // pgvector embedding; set dimension to your model (384/768/1024 etc.)
  embedding     Unsupported("vector(384)")?

  brand         String?
  category      String?

  receiptItems  ReceiptItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([canonicalName])
}

/// Immutable totals snapshot for the report period
model ReportSnapshot {
  id              String   @id @default(uuid())
  reportId        String   @unique
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  currencyCode    String
  currencySymbol  String
  incomeReceived  Int
  expenseSpend    Int
  netFlow         Int

  // Top payees / largest transactions stored as small JSON arrays (display-only, not queried)
  expenseByPayee    Json?  // [{ payee, amount }]
  largestExpenses   Json?  // [{ payee, amount, date }]
  largestIncome     Json?  // [{ payee, amount, date }]
  uncategorized     Json?  // [{ amount, date }]

  @@index([reportId])
}

/// Month-over-month comparison stored per report
model ReportComparison {
  id                      String  @id @default(uuid())
  reportId                String  @unique
  report                  Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  prevMonthAvailable      Boolean
  incomeReceivedDelta     Int
  incomeReceivedDeltaPct  Float?
  expenseSpendDelta       Int
  expenseSpendDeltaPct    Float?
  netFlowDelta            Int
  netFlowDeltaPct         Float?

  topCategoryChanges      Json?   // [{ category, delta, deltaPct }]

  @@index([reportId])
}

/// Category breakdown for the report period (queryable across months)
model ReportCategoryBreakdown {
  id          String  @id @default(uuid())
  reportId    String
  report      Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  category    String
  spend       Int
  pct         Float

  @@index([reportId])
  @@index([category])
}

/// Recurring charge candidates detected for the report period
model ReportRecurringCandidate {
  id              String   @id @default(uuid())
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  payee           String
  direction       String   // "expense" | "income"
  occurrences     Int
  months          Int
  avgAmount       Int
  medianAmount    Int
  amountStdDev    Int
  amountStdDevPct Float
  lastSeenAt      DateTime
  last3Amounts    Json?    // [{ at, amount }]
  nextExpectedWindow Json? // { from, to }

  @@index([reportId])
  @@index([payee])
}