generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

// A model to handle JWT sessions for mobile clients
model MobileJWTToken {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Token Family Management
  familyId      String
  tokenVersion  Int      @default(1) // Version number for rotation

  // Hashed tokens for security
  accessTokenHash   String    @unique
  refreshTokenHash  String    @unique
  
  // Token metadata
  isActive      Boolean   @default(true)
  expiresAt     DateTime
  refreshExpiresAt DateTime
  
  // Family invalidation tracking
  familyInvalidated Boolean  @default(false)
  invalidatedAt     DateTime?
  invalidatedReason String?   // "compromised", "logout", "suspicious_activity"

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Pending confirmation field to track if the token was recieved by the mobile client
  pendingConfirmation Boolean @default(false)
  
  @@index([userId, isActive])
  @@index([familyId, tokenVersion])
  @@index([userId, familyInvalidated])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

model User {
  id            String    @id @default(uuid())
  name          String?
  /// IANA timezone id, e.g. "Europe/Madrid", "America/New_York" used to send notifiactions at the right time, default is UTC
  timezone      String?   @default("UTC")
  email         String?   @unique
  preferredLanguage String? @default("EN")
  preferredCurrency Currency? @relation(fields: [preferredCurrencyId], references: [id])
  preferredCurrencyId String?
  image         String?
  category      Category[]
  budgets       Budget[]
  budgetMutes   BudgetMute[]
  feedbacks    Feedback[]
  appleSubscriptionExpiresAt DateTime?
  appleSubscriptionCountry String?
  appleSubscriptionGracePeriodExpiresAt DateTime?
  /// Start of the CURRENT subscription period (Apple transaction purchaseDate). Moves forward on every renewal.
  appleSubscriptionStartedAt DateTime?
  /// First time this user ever subscribed (Apple originalPurchaseDate). Stable across renewals — use this for tenure.
  appleSubscriptionOriginalPurchaseDate DateTime?
  /// When the user's free trial began. Non-null means they had a trial; never cleared, so it survives trial -> paid conversion.
  appleTrialStartedAt DateTime?
  /// See SubscriptionStatus in src/types/Subscription.ts for the full set of values.
  appleSubscriptionStatus String   @default("inactive") // "active", "past_due", "grace_period", "canceled", "expired", "grace_period_expired", "active_until_expiration", "trial", "inactive"
  report Report[]
  sendMonthlyReport Boolean? @default(true)
  gdprConsent DateTime?
  mobileTokens  MobileJWTToken[]
  accountAccess UserAccountAccess[]
  createdTransactions Transaction[]
  deviceToken String? @unique
  createdInvites AccountInvite[]
  categoryMappings CategoryMapping[]
  transactionPlacements TransactionPlacement[]
}

model Transaction {
  id          String    @id @default(uuid())
  amount      Int
  payee       String?
  notes       String?
  accountId   String
  account     UserAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   String    // User ID of who created this transaction
  createdByUser User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  placements  TransactionPlacement[]
  /// Last writer's database transaction, set by a trigger; the `/sync` feed's cursor. See the
  /// offline_sync migration.
  syncTxid    Unsupported("xid8")? @default(dbgenerated("pg_current_xact_id()"))
  @@unique([id])
  @@index([createdBy])
  @@index([accountId, syncTxid])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  userId      String
  owner       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String?
  icon        String?
  /// Tie-breaker for name matching: when several of a viewer's categories share a normalized name, the oldest wins.
  createdAt   DateTime  @default(now())
  /// Multilingual embedding of the name, used only to suggest mappings. Empty until first computed.
  nameEmbedding Float[] @default([])
  /// The normalized name `nameEmbedding` was computed from, so a rename is detected as stale.
  nameEmbeddingKey String?
  /// Set instead of deleting. The owner no longer sees it and their rows in it
  /// read as uncategorized, but a partner's mapping or pick for those rows still
  /// holds, so deleting a category never re-sorts somebody else's books.
  archivedAt  DateTime?
  transactions Transaction[]
  budgetAllocations BudgetAllocation[]
  mappedFrom  CategoryMapping[] @relation("CategoryMappingSource")
  mappedTo    CategoryMapping[] @relation("CategoryMappingTarget")
  placements  TransactionPlacement[]
  /// Last writer's database transaction, set by a trigger; the `/sync` feed's cursor. See the
  /// offline_sync migration.
  syncTxid    Unsupported("xid8")? @default(dbgenerated("pg_current_xact_id()"))
  @@unique([id])
  @@index([userId, syncTxid])
}

/// A per-viewer rule "count partner category `source` under my category `target`".
/// Only the viewer sees it; the author's transactions are never changed by it.
model CategoryMapping {
  viewerId         String
  viewer           User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  sourceCategoryId String
  sourceCategory   Category @relation("CategoryMappingSource", fields: [sourceCategoryId], references: [id], onDelete: Cascade)
  /// Null means the viewer removed it: the source counts nowhere for them,
  /// not even under a category with the same name.
  targetCategoryId String?
  targetCategory   Category? @relation("CategoryMappingTarget", fields: [targetCategoryId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  syncTxid         Unsupported("xid8")? @default(dbgenerated("pg_current_xact_id()"))

  @@id([viewerId, sourceCategoryId])
  @@index([targetCategoryId])
  @@index([sourceCategoryId])
}

/// A per-viewer pick for one row someone else added: "count this row under my
/// category". It beats every other rule for that viewer, and only they see it;
/// the row itself keeps its author's category.
model TransactionPlacement {
  viewerId      String
  viewer        User        @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  syncTxid      Unsupported("xid8")? @default(dbgenerated("pg_current_xact_id()"))

  @@id([viewerId, transactionId])
  @@index([transactionId])
  @@index([categoryId])
}

model Currency {
  id          String    @id @default(uuid())
  name        String
  code        String
  symbol      String
  userAccounts UserAccount[]
  exchangeRate Float
  budget Budget[]
  users        User[]
  @@unique([id])
}

// A model to store User Accounts
model UserAccount {
  id         String   @id @default(uuid())
  name       String
  institutionName String?
  transactions Transaction[]
  currencyId String
  currency   Currency  @relation(fields: [currencyId], references: [id])
  budgets    BudgetAccount[]
  userAccess UserAccountAccess[] // Many-to-many relation
  invites    AccountInvite[]
  @@unique([id])
}

// Join table for User and UserAccount (shareable accounts)
model UserAccountAccess {
  userId        String
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAccountId String
  userAccount   UserAccount   @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  role          String?       // "owner", "collaborator", "editor"
  createdAt     DateTime      @default(now())
  
  @@id([userId, userAccountId])
}

// Table to store shared account invites
model AccountInvite {
  id          String      @id @default(uuid())
  /// The 6-digit invite code the recipient types in the app.
  code        String      @unique
  accountId   String
  account     UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime    @default(now())
  
  @@index([code])
  @@index([accountId])
}

// Join table for Budget and UserAccount
model BudgetAccount {
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userAccountId String
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  @@id([budgetId, userAccountId])
}

// Enum to represent budget frequency
enum BudgetFrequency {
  WEEKLY
  MONTHLY
  YEARLY
  QUARTERLY
}

model Budget {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String
  enableNotifications Boolean @default(false)
  description   String
  totalAmount   Float
  currencyId    String
  currency      Currency  @relation(fields: [currencyId], references: [id])
  frequency     BudgetFrequency
  /// Only the owner sees it, even when everyone on its accounts could.
  isPrivate     Boolean   @default(false)
  /// Every payment on its accounts counts, whatever its category; allocations then only carry limits.
  allCategories Boolean   @default(false)
  /// Each allocation is a limit of its own, together at most totalAmount.
  splitByCategory Boolean @default(false)
  /// What enableNotifications sends: 80% of the total, the total going over, a category going over.
  alertAtPace   Boolean   @default(false)
  alertWhenOver Boolean   @default(true)
  alertCategoryOver Boolean @default(false)
  /// The last account the owner stopped being on (left, or was taken off), named as it was then —
  /// they can't read it any more. Cleared by the owner's next save of the budget.
  lostAccountName String?
  lostAccountAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  budgetAllocations BudgetAllocation[]
  accounts      BudgetAccount[]
  mutes         BudgetMute[]
}

// Someone who sees a budget and doesn't want its alerts. Only their own.
model BudgetMute {
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([budgetId, userId])
  @@index([userId])
}

// New model for Budget Allocations
model BudgetAllocation {
  id            String    @id @default(uuid())
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allocatedAmount Float
}
// Model for financial reports
model Report {
  id            String    @id @default(uuid())
  userId        String
  periodStart   DateTime  // month bucket, e.g. 2026-01-01T00:00:00.000Z
  health        String?  // "green" | "yellow" | "red" - overall financial health for the period
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  data          Json      // JSON data for the report, it might be changed frequently and we don't want to change the schema, indexing and querying is not that important
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  snapshot      ReportSnapshot?
  recurringCandidates ReportRecurringCandidate[]
  categoryBreakdowns  ReportCategoryBreakdown[]
  comparisons   ReportComparison?
  
  @@index([userId, createdAt])
}

// Model to store user feedback
model Feedback {
  id        String   @id @default(uuid())
  userId    String
  message   String   @db.Text
  
  // Device info as separate columns
  deviceModel      String?  @db.VarChar(50)
  deviceOsVersion  String?  @db.VarChar(10)
  deviceAppVersion String?  @db.VarChar(10)
  
  // Metadata
  createdAt DateTime @default(now())
  
  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
}

/// Immutable totals snapshot for the report period
model ReportSnapshot {
  id              String   @id @default(uuid())
  reportId        String   @unique
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  currencyCode    String
  currencySymbol  String
  incomeReceived  Int
  expenseSpend    Int
  netFlow         Int

  // Top payees / largest transactions stored as small JSON arrays (display-only, not queried)
  expenseByPayee    Json?  // [{ payee, amount }]
  largestExpenses   Json?  // [{ payee, amount, date }]
  largestIncome     Json?  // [{ payee, amount, date }]
  uncategorized     Json?  // [{ amount, date }]

  @@index([reportId])
}

/// Month-over-month comparison stored per report
model ReportComparison {
  id                      String  @id @default(uuid())
  reportId                String  @unique
  report                  Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  prevMonthAvailable      Boolean
  incomeReceivedDelta     Int
  incomeReceivedDeltaPct  Float?
  expenseSpendDelta       Int
  expenseSpendDeltaPct    Float?
  netFlowDelta            Int
  netFlowDeltaPct         Float?

  topCategoryChanges      Json?   // [{ category, delta, deltaPct }]

  @@index([reportId])
}

/// Category breakdown for the report period (queryable across months)
model ReportCategoryBreakdown {
  id          String  @id @default(uuid())
  reportId    String
  report      Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  category    String
  spend       Int
  pct         Float

  @@index([reportId])
  @@index([category])
}

/// Recurring charge candidates detected for the report period
model ReportRecurringCandidate {
  id              String   @id @default(uuid())
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  payee           String
  direction       String   // "expense" | "income"
  occurrences     Int
  months          Int
  avgAmount       Int
  medianAmount    Int
  amountStdDev    Int
  amountStdDevPct Float
  lastSeenAt      DateTime
  last3Amounts    Json?    // [{ at, amount }]
  nextExpectedWindow Json? // { from, to }

  @@index([reportId])
  @@index([payee])
}

/// A synced row that is gone for someone: deleted, or (for a transaction) moved to
/// another account. Written by triggers, read by `GET /sync`, pruned by
/// `sync_prune_tombstones`. `accountId` is the account it left; `userId` is the
/// author for a row, the owner for a category, the viewer for a mapping or pick.
model SyncTombstone {
  id        BigInt   @id @default(autoincrement())
  /// transaction, category, categoryMapping or placement.
  entity    String
  entityId  String
  accountId String?
  userId    String?
  syncTxid  Unsupported("xid8")? @default(dbgenerated("pg_current_xact_id()"))
  deletedAt DateTime @default(now())

  @@index([syncTxid])
  @@index([entity, entityId])
}

/// One row. Tombstones up to `prunedThrough` have been dropped, so a cursor at or
/// below it is answered with a reset.
model SyncHorizon {
  id            Int  @id @default(1)
  prunedThrough Unsupported("xid8")?
}
