generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A model to store the 3rd party account details for authentication
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  category      Category[]
  userAccounts  UserAccount[]
  budgets       Budget[]
  password      String?
  role          UserRole @default(USER)
  stripeCustomerId String?
  stripeSubscriptionEndDate DateTime?
  stripeSubscriptionCancelAtDate DateTime?
  stripePriceId String?
  hasActiveStripeSubscription Boolean? @default(false)
  report Report[]
  sendMonthlyReport Boolean? @default(false)
  gdprConsent DateTime?
}

model Transaction {
  id          String    @id @default(uuid())
  amount      Int
  payee       String?
  notes       String?
  accountId   String
  account     UserAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  @@unique([id])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String?
  transactions Transaction[]
  budgetAllocations BudgetAllocation[]
  @@unique([id])
}

model Currency {
  id          String    @id @default(uuid())
  name        String
  code        String
  symbol      String
  userAccounts UserAccount[]
  exchangeRate Float
  budget Budget[]
  @@unique([id])
}

// A Model to store the verification token for user credentials signup
model VerificationToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires    DateTime
  @@unique([email, token])
}

// A model to store the reset password token
model PasswordResetToken {
  id         String   @id @default(uuid())
  email      String
  token      String   @unique
  expires    DateTime
  @@unique([email, token])
}

// A model to store User Accounts
model UserAccount {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  institutionName String?
  stripeAccountId String?
  stripeLastTransactionsRefreshId String?
  last4      String?
  balance   Int?
  stripeAccountType      String?  
  transactions Transaction[]
  currencyId String
  currency   Currency  @relation(fields: [currencyId], references: [id])
  budgets    BudgetAccount[]
  @@unique([id])
}

// Join table for Budget and UserAccount
model BudgetAccount {
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userAccountId String
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  @@id([budgetId, userAccountId])
}

// Enum to represent budget frequency
enum BudgetFrequency {
  MONTHLY
  WEEKLY
  YEARLY
  QUARTERLY
}

model Budget {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  totalAmount   Float
  currencyId    String
  currency      Currency  @relation(fields: [currencyId], references: [id])
  frequency     BudgetFrequency
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  budgetAllocations BudgetAllocation[]
  accounts      BudgetAccount[]
}

// New model for Budget Allocations
model BudgetAllocation {
  id            String    @id @default(uuid())
  budgetId      String
  budget        Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allocatedAmount Float
  spentAmount   Float     @default(0)
}

model Report {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  data          Json      // JSON data for the report, it might be changed frequently and we don't want to change the schema, indexing and querying is not that important
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  
  @@index([userId, createdAt])
}