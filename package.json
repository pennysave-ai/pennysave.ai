{
  "name": "pennysave.ai",
  "version": "0.9.2",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run start:db\" \"npm run redis\"",
    "next:dev": "dotenv -e .env.local -- next dev",
    "build:dev": "dotenv -e .env.local prisma migrate deploy && next build",
    "redis": "redis-stack-server",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "npm run next:start",
    "populate_currency:db:dev": "dotenv -e .env.local -- ts-node --project tsconfig.json seeds/populate_currency_db.ts",
    "populate_currency:db:prod": "dotenv -e .env.prod -- ts-node --project tsconfig.json seeds/populate_currency_db.ts",
    "next:start": "next start",
    "lint": "eslint src --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "prisma:migrate:dev": "dotenv -e .env.local -- npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:prod": "dotenv -e .env.prod prisma migrate deploy",
    "prisma:generate:dev": "dotenv -e .env.local -- npx prisma generate --schema=prisma/schema.prisma",
    "start:db": "docker run --rm -p 5432:5432 -v postgres-data:/var/lib/postgresql/data -e POSTGRES_HOST_AUTH_METHOD=trust pennysave-postgres",
    "reset:db": "dotenv -e .env.local -- npx prisma migrate reset && npx prisma database push"
  },
  "dependencies": {
    "@heroui/divider": "^2.2.20",
    "@heroui/theme": "^2.4.23",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@upstash/qstash": "^2.10.1",
    "@vercel/analytics": "^1.5.0",
    "apns2": "^12.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv-cli": "^7.4.4",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "redis": "^5.10.0",
    "resend": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@sentry/nextjs": "^10.29.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.17.16",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.1.2",
    "cssnano": "^7.0.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.16",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.51.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.9"
  }
}
