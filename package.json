{
  "name": "pennysave.ai",
  "version": "0.9.2",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run next:dev\" \"npm run start:dev:websocket\"",
    "next:dev": "dotenv -e .env.local -- next dev",
    "start:dev:websocket": "dotenv -e .env.local -- ts-node --project tsconfig.websocket.json src/websocket.ts",
    "start:prod:websocket": "dotenv -e .env.prod -- ts-node --project tsconfig.websocket.json src/websocket.ts",
    "build:dev": "dotenv -e .env.local prisma migrate deploy && next build",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "concurrently \"npm run next:start\" \"npm run start:prod:websocket\"",
    "populate:db:dev": "dotenv -e .env.local -- ts-node --project tsconfig.websocket.json populate_db.ts",
    "populate:db:prod": "dotenv -e .env.prod -- ts-node --project tsconfig.websocket.json populate_db.ts",
    "next:start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "prisma:migrate:dev": "dotenv -e .env.local -- npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:prod": "dotenv -e .env.prod prisma migrate deploy",
    "prisma:generate:dev": "dotenv -e .env.local -- npx prisma generate --schema=prisma/schema.prisma",
    "start:db": "docker run --rm -p 5432:5432 -v postgres-data:/var/lib/postgresql/data -e POSTGRES_HOST_AUTH_METHOD=trust postgres",
    "reset:db": "dotenv -e .env.local -- npx prisma migrate reset && npx prisma database push"
  },
  "dependencies": {
    "@auth/core": "0.18.1",
    "@auth/prisma-adapter": "1.0.6",
    "@emotion/is-prop-valid": "^1.3.1",
